<mxfile host="Electron" modified="2026-11-25T16:10:00.000Z" agent="Antigravity" version="21.0.0" type="device"><diagram id="gameplay-flowchart" name="Diagrama de Flujo e Interacción de Mecánicas"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1600" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="AJEDREZ SALVAJE : DIAGRAMA DE FLUJO E INTERACCIÓN DE MECÁNICAS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=15;fontColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="260" y="20" width="720" height="30" as="geometry" /></mxCell><mxCell id="subtitle" value="Secuencia ordenada por ronda: Clima, Balance de Agua, Vivero, Cazador, Jugador y Rival" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontStyle=2;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="260" y="50" width="720" height="22" as="geometry" /></mxCell><mxCell id="n_start" value="INICIO DE RONDA&#10;t = t + 1 (Sincronización de Tablero 3D)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="470" y="95" width="300" height="50" as="geometry" /></mxCell><mxCell id="n_fase1" value="FASE 1: CLIMA (Simulación Monte Carlo)&#10;Muestreo por transformada inversa estocástica U(0, 1)&#10;Salida: Estable | Lluvia | Helada | Catástrofe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;align=center;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="430" y="180" width="380" height="65" as="geometry" /></mxCell><mxCell id="n_fase2" value="FASE 2: BALANCE HÍDRICO (Dinámica de Sistemas)&#10;Ecuación diferencial: dA/dt = F_entrada menos F_salida&#10;Integración de Euler (dt = 1.0 ronda)&#10;Condensación de Frailejones vs. Evaporación Climática" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;align=center;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="430" y="280" width="380" height="75" as="geometry" /></mxCell><mxCell id="n_cond_water" value="¿Reserva de&#10;Agua &gt; 30%?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="540" y="390" width="160" height="80" as="geometry" /></mxCell><mxCell id="n_nursery_off" value="Vivero Inactivo&#10;(Servidor detenido: μ = 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;align=center;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="820" y="405" width="200" height="50" as="geometry" /></mxCell><mxCell id="n_fase3" value="FASE 3: VIVERO DE REGENERACIÓN (Colas M/M/1)&#10;Atención estocástica con tasa μ = 0.50 frailejones/ronda&#10;Disciplina FIFO con buffer acotado K = 16" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;align=center;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="430" y="510" width="380" height="65" as="geometry" /></mxCell><mxCell id="n_cond_germ" value="¿Germinación&#10;completada?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="530" y="610" width="180" height="80" as="geometry" /></mxCell><mxCell id="n_cond_free" value="¿Casilla libre&#10;en fila base?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="520" y="730" width="200" height="80" as="geometry" /></mxCell><mxCell id="n_respawn" value="REAPARICIÓN DE FRAILEJÓN&#10;Peón reingresa en fila inicial (rango 2 o 7)&#10;Efecto visual verde de regeneración en tablero 3D" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;align=center;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="440" y="850" width="360" height="55" as="geometry" /></mxCell><mxCell id="n_requeue" value="Reencolamiento en vivero&#10;(Espera liberación de casilla)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;align=center;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="820" y="745" width="200" height="50" as="geometry" /></mxCell><mxCell id="n_fase4" value="FASE 4: PERTURBACIÓN AMBIENTAL Y DESESTABILIZADOR&#10;1. Cazador Furtivo (ABM): Avance voraz minimizando distancia Manhattan d_M&#10;2. Retroexcavadora (Caminata 2D): Paso aleatorio ortogonal (política Redraw)&#10;Peones alcanzados ingresan a la cola del vivero M/M/1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;align=center;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="410" y="945" width="420" height="85" as="geometry" /></mxCell><mxCell id="n_fase5" value="FASE 5: TURNO TÁCTICO DEL JUGADOR ACTIVO (Reglas FIDE)&#10;Selección por raycasting orbital en tablero 3D&#10;Validación estricta en movement_validator.gd y chess_match.gd&#10;Ejecución del movimiento y registro en notación algebraica" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;align=center;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="410" y="1065" width="420" height="80" as="geometry" /></mxCell><mxCell id="n_fase6" value="FASE 6: TRANSICIÓN ESPACIAL Y TURNO DEL RIVAL&#10;Giro tridimensional de 180 grados del tablero hacia la perspectiva rival&#10;Inversión del indicador de turno activo en el GameHUD diegético&#10;Ejecución de la jugada del oponente (Jugador 2 local o rival automático)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;align=center;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="410" y="1180" width="420" height="80" as="geometry" /></mxCell><mxCell id="n_cond_verdict" value="¿Jaque mate FIDE o&#10;Agua &lt;= 0%?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="520" y="1295" width="200" height="90" as="geometry" /></mxCell><mxCell id="n_end_victory" value="FIN DE PARTIDA&#10;Victoria / Derrota FIDE (Jaque Mate)&#10;Colapso Ambiental (Sequía 0%)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E9ECEF;strokeColor=#000000;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#000000;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="820" y="1310" width="260" height="60" as="geometry" /></mxCell><mxCell id="n_advance" value="AVANCE DE CICLO&#10;Actualización de métricas, conservación de stock y paso a t + 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;align=center;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="440" y="1425" width="360" height="50" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="n_start" target="n_fase1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="n_fase1" target="n_fase2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="n_fase2" target="n_cond_water"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Sí (Agua &gt; 30%)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="n_cond_water" target="n_fase3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="No (Sequía)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="n_cond_water" target="n_nursery_off"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5_rec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.65;" parent="1" edge="1" source="n_nursery_off" target="n_fase4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="430" /><mxPoint x="1070" y="1000" /></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jetty