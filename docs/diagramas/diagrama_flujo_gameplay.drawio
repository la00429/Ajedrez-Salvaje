;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=1;entryY=0.35;" parent="1" edge="1" source="n_requeue" target="n_fase4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="975" /></Array></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="n_respawn" target="n_fase4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="n_fase4" target="n_fase5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="n_fase5" target="n_fase6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="n_fase6" target="n_cond_verdict"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="Sí (Veredicto final)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="n_cond_verdict" target="n_end_victory"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="No (Partida activa)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="n_cond_verdict" target="n_advance"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="Retorno a nueva ronda (t + 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" parent="1" edge="1" source="n_advance" target="n_start"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="1450" /><mxPoint x="170" y="120" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>